{
  "name": "worker-crawler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FOR-71 — Crawler e-SAJ TJSP (estágio 1, deslogado). Worker externo que consome crawler_queue e popula a base própria (FOR-69) via service_role.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
