{
  "name": "worker-crawler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FOR-71 — Crawler e-SAJ TJSP (estágio 1, deslogado). Worker externo que consome crawler_queue e popula a base própria (FOR-69) via service_role.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "SUPABASE_URL=http://localhost:54321 SUPABASE_SERVICE_ROLE_KEY=test-only-unit-tests tsx --test src/*.test.ts",
    "ingest": "tsx src/ingest-djen.ts",
    "reclassify-oc": "tsx src/reclassify-oc.ts",
    "import-csv-legado": "tsx src/import-csv-legado.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cheerio": "^1.0.0",
    "undici": "^6.19.0",
    "dotenv": "^16.4.5",
    "ws": "^8.18.0",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10"
  }
}
