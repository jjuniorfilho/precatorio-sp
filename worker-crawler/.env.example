# Supabase — escolha UMA das formas de credencial:
SUPABASE_URL=https://<proj>.supabase.co
#
# (A) service_role (bypassa RLS) — manter SECRETA:
# SUPABASE_SERVICE_ROLE_KEY=__service_role_key__
#
# (B) login admin (sem service_role) — anon key é pública; admin é a credencial:
SUPABASE_ANON_KEY=__anon_publishable_key__
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=__senha_admin__

# Loop / fila
CLAIM_BATCH=25            # itens por claim_crawler_jobs
POLL_EMPTY_MS=15000       # sleep quando a fila está vazia
LOOP_ENABLED=true

# Educação com o e-SAJ (override do coleta_config.params se quiser)
CONCURRENCY=3             # requisições simultâneas
DELAY_MS=400             # atraso entre requisições
REQUEST_TIMEOUT_MS=15000
MAX_HTTP_RETRY=3         # backoff em 429/5xx/timeout

ESAJ_BASE=https://esaj.tjsp.jus.br/cpopg

# FOR-102 — endpoint HTTP síncrono (POST /valor-pago), chamado pelo buscar-precatorio e
# pelo disparar-valor-pago (admin). Escuta só em 127.0.0.1 — exposição pública é via nginx
# + Let's Encrypt em crawler.forjuris.com.br (ver README.md).
HTTP_PORT=3200
WORKER_HTTP_SECRET=__gere_um_segredo_aleatorio__

# FOR-143 — gateia a reconciliação de processos/incidentes "LEGADO-" (import do CSV legado)
# em persistTree(). Default true; custa 1 SELECT extra por processo crawleado. Pode virar
# false depois que o backfill do FOR-143 for absorvido (ver README.md).
LEGADO_RECONCILE=true
