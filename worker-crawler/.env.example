# Supabase (worker usa SERVICE_ROLE — manter SECRETA, só na VPS)
SUPABASE_URL=https://<proj>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=__service_role_key__

# Loop / fila
CLAIM_BATCH=25            # itens por claim_crawler_jobs
POLL_EMPTY_MS=15000       # sleep quando a fila está vazia
LOOP_ENABLED=true

# Educação com o e-SAJ (override do coleta_config.params se quiser)
CONCURRENCY=3             # requisições simultâneas
DELAY_MS=400             # atraso entre requisições
REQUEST_TIMEOUT_MS=15000
MAX_HTTP_RETRY=3         # backoff em 429/5xx/timeout

ESAJ_BASE=https://esaj.tjsp.jus.br/cpopg
