# Supabase (preenchido automaticamente nas Edge Functions — não precisa setar manualmente)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Resend — envio de e-mail
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@forjuris.com.br

# Z-API — envio de WhatsApp
ZAPI_INSTANCE_ID=<instance-id>
ZAPI_TOKEN=<instance-token>
ZAPI_CLIENT_TOKEN=<client-token>
